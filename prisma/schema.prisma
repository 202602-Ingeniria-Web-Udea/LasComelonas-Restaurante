// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Enum_Role {
  ADMIN
  USER
}

enum Enum_Order_Status {
  PENDING
  COMPLETED
  PAID
  DELIVERED
  CANCELED
  SHIPPED
}

enum Enum_PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PAYPAL
  CASH
}

enum Enum_PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Tipo de movimiento de inventario: ENTRY suma al saldo y EXIT resta.
enum Enum_Transaction_Type {
  ENTRY
  EXIT
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  lastName     String?
  password     String
  deleted      Boolean       @default(false)
  enabled      Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  role         Enum_Role     @default(USER)
  profile      Profile?
  masters      Master[]
  transactions Transaction[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  address   String
  deleted   Boolean  @default(false)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Profile {
  id        String   @id @default(cuid())
  address   String
  phone     String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  price       Float
  // En la carta "cantidad" son las piezas por porción (8 en un maki, 1 en un ramen)
  // y "codigo" es el número del plato en el menú.
  cantidad    Int
  codigo      Int
  deleted     Boolean     @default(false)
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  categories  Category[]
  suppliers   Supplier[]
  orderItems  OrderItem[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String
  deleted     Boolean   @default(false)
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Supplier {
  id          String    @id @default(cuid())
  name        String
  description String
  deleted     Boolean   @default(false)
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Order {
  id             String            @id @default(cuid())
  orderDate      DateTime          @default(now())
  subTotalAmount Float
  taxAmount      Float
  totalAmount    Float
  status         Enum_Order_Status
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  customer       Customer          @relation(fields: [customerId], references: [id])
  customerId     String
  orderItems     OrderItem[]
  payment        Payment?
}

model OrderItem {
  id        String   @id @default(cuid())
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
}

model Payment {
  id          String             @id @default(cuid())
  paymentDate DateTime           @default(now())
  amount      Float
  method      Enum_PaymentMethod
  status      Enum_PaymentStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  orderId     String             @unique
  order       Order              @relation(fields: [orderId], references: [id])
}

// Maestro: un insumo de la cocina (arroz, alga nori, salmón...) con su saldo actual.
model Master {
  id           String        @id @default(cuid())
  name         String        @unique
  // Saldo actual. Se actualiza en la misma operación que crea cada movimiento.
  balance      Int           @default(0)
  deleted      Boolean       @default(false)
  enabled      Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdBy    User          @relation(fields: [createdById], references: [id])
  createdById  String
  transactions Transaction[]
}

// Movimiento de inventario de un Maestro. Igual que Order y Payment, es un
// registro histórico, por eso no lleva los campos deleted ni enabled.
model Transaction {
  id        String                @id @default(cuid())
  type      Enum_Transaction_Type
  quantity  Int
  date      DateTime              @default(now())
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  master    Master                @relation(fields: [masterId], references: [id])
  masterId  String
  // Usuario con sesión iniciada que registró el movimiento (el responsable).
  user      User                  @relation(fields: [userId], references: [id])
  userId    String
}
